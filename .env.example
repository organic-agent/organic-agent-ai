# cp .env.example .env 후 값을 채우세요. .env는 gitignore 대상이라 커밋되지 않습니다.

# Notion Integration 토큰 (https://www.notion.so/profile/integrations)
NOTION_TOKEN=ntn_여기에_붙여넣기

# 워크스페이스 URL 슬러그 — app.notion.com/p/<이 부분>/... (출처 링크 생성에 사용)
NOTION_WORKSPACE=yasic

# 로그인 (공유 계정 1개). 둘 다 설정하면 인증 활성화, 미설정이면 무인증(로컬 개발용)
NOTIONCHAT_AUTH_ID=팀공유아이디
NOTIONCHAT_AUTH_PASSWORD=팀공유비밀번호

# 아래는 선택 — 미설정 시 config.py 기본값 사용
# AWS_REGION=us-east-1
# NOTIONCHAT_MODEL_ID=openai.gpt-oss-120b-1:0
