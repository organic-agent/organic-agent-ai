# wes-score GPU 워커(#87) — 부팅마다 한 번 띄운다. 워커는 집을 사진이 없으면 유휴 30초 뒤 자기 인스턴스를 StopInstances 하고
# exit 0 으로 끝난다(인프라 계획 §4.5 층 1). 켜는 것은 wes(W6, StartInstances)·최후 정지는 CloudWatch 알람(층 4).
#
# 설치(Image Builder 컴포넌트): 세 파일을 아래 경로에 두고 `systemctl enable wes-score-gpu.service`.
#   /usr/local/bin/wes-score-env.sh       (0755)
#   /usr/local/bin/wes-score-gpu-run.sh   (0755)
#   /etc/systemd/system/wes-score-gpu.service
# 전제: NVIDIA 드라이버(≥ 525, 컨테이너 CUDA 12.1) · docker · nvidia-container-toolkit(`nvidia-ctk runtime configure --runtime=docker`) ·
#       IMDSv2 hop limit 2 · 인스턴스 역할(README.md §권한).
[Unit]
Description=wes-score GPU worker (pipeline v2, organic-agent-ai #75)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# 크래시 루프로 GPU 시간을 태우지 않는다: 10분 안에 3번 실패하면 더 올리지 않는다(그 뒤는 CloudWatch 알람이 끈다).
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/local/bin/wes-score-gpu-run.sh
# 비밀번호가 든 env 파일은 유닛이 끝나면 지운다(정상 종료·실패 모두).
ExecStopPost=/bin/rm -f /run/wes-score.env
# exit 0(유휴 자기 정지) 은 재시작하지 않는다 — 인스턴스가 곧 꺼진다. exit 1(연속 실패 상한 #81)·크래시만 30초 뒤 재시작.
Restart=on-failure
RestartSec=30
# docker stop 이 SIGTERM 을 주면 워커는 진행 중 배치를 rollback 으로 돌려준다(잠금은 트랜잭션에 묶여 있다). 60초면 충분.
TimeoutStopSec=60
KillMode=mixed
# 자격증명은 인스턴스 역할(IMDS). 파일에 키 없음.
Environment=AWS_REGION=ap-northeast-2

[Install]
WantedBy=multi-user.target
